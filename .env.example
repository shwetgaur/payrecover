# Groq — required for live diagnose rationale + Hinglish compose.
# The agent still classifies and acts when this is missing (rule catalog).
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant
GROQ_FALLBACK_MODEL=llama-3.1-8b-instant

# HMAC secret for POST /webhooks/razorpay. Empty = verify skipped (demo only).
RAZORPAY_WEBHOOK_SECRET=

# SQLite by default. Use Postgres on Railway/Render:
# DATABASE_URL=postgresql+psycopg://user:pass@host:5432/payrecover
DATABASE_URL=sqlite:///./data/payrecover.db

# CORS — comma-separated local origins. Vercel (*.vercel.app) allowed when true below.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
CORS_ALLOW_VERCEL=true

# Frozen clock for sample-batch + eval so quiet-hours do not queue the gold set.
# Leave empty to use wall clock (IST).
DEMO_NOW_IST=2026-08-22T14:30:00
